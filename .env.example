# Pick ONE provider and paste its key. Gemini is free and the default.
#   gemini     -> https://aistudio.google.com/apikey   (free)
#   groq       -> https://console.groq.com/keys        (free, but 8k tokens/min is too small for full runs)
#   openrouter -> https://openrouter.ai/keys           (free ":free" models)
#   openai     -> https://platform.openai.com/api-keys (paid)
LLM_PROVIDER=gemini
GEMINI_API_KEY=paste-your-key-here

# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# Optional
# NPS_MODEL=gemini-3.5-flash-lite      # override the provider's default model
# NPS_MIN_SECONDS_BETWEEN_CALLS=4.5    # space out requests for free-tier rate limits
# NPS_SURVEY_PATH=data/nps_survey.csv
